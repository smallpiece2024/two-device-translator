{
  "name": "two-device-translator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:ws\"",
    "dev:web": "next dev",
    "dev:ws": "tsx --watch --env-file-if-exists=.env server/index.ts",
    "build": "next build",
    "build:server": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "start": "next start",
    "lint": "eslint src server shared",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "test": "jest --passWithNoTests",
    "test:e2e": "playwright test",
    "sb": "dotenv -o -e .env -- npx supabase"
  },
  "dependencies": {
    "@google-cloud/speech": "^7.5.0",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@google-cloud/translate": "^9.4.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "jose": "^5.10.0",
    "next": "^15.3.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "ws": "^8.18.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/ws": "^8.5.14",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.3.4",
    "tsc-alias": "^1.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
