# Supabase（ブラウザ・Server Component / Route Handler から利用。anon key、RLS適用）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase（WSサーバー / 一部 Route Handler 専用。service_role key、RLSバイパス。
# NEXT_PUBLIC_ を付けず、ブラウザに絶対に露出させないこと）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ゲスト識別クッキー（gtt_guest）の署名鍵（HS256、jose）。
# Next.js と WSサーバーで同一値を共有する。NEXT_PUBLIC_ を付けない。
# 32バイト以上のランダム文字列にすること（例: openssl rand -base64 32）。
GUEST_COOKIE_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes

# 招待URL（QR/URLテキスト）のベースURL（サーバー専用、NEXT_PUBLIC_ を付けない）。
# 設定するとリクエストの host / x-forwarded-proto ヘッダより優先される
# （Host Headerポイズニングによる招待URL汚染の防御。未設定時はヘッダから
# フォールバック生成するが、本番では明示的な設定を推奨）。
# 例: https://translator.example.com（末尾スラッシュ不要）
APP_BASE_URL=https://your-domain.example.com

# Supabase CLI（`npm run sb -- <subcommand>`）専用のアクセストークン。
# Supabase ダッシュボード → Account → Access Tokens で発行する（sbp_ で始まる）。
# マシン共有の `supabase login` トークンに依存せず、プロジェクトごとに正しい
# アカウント/組織へ接続するために使う。アプリの実行時には不要（本番VMに置かない）。
SUPABASE_ACCESS_TOKEN=

# WSサーバーの join 検証モード（既定=未設定=strict: Supabase/ゲストJWTを厳格検証）。
# "insecure" にすると token の中身を検証しないダミー実装に切り替わる
# （ログインUI/招待フロー未実装時のE2E・手動確認専用）。本番では絶対に設定しないこと。
# AUTH_MODE=insecure
